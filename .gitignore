# node
node_modules/
dist/
.env
.env.*
!.env.example

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# rust / ink!
target/
coprocessor/target/

# circom / snarkjs intermediate build output (regenerated via `make zk`)
circuits/build/
*.r1cs
*.wtns
*.ptau
# Proving keys are NOT ignored in sdk/artifacts: they must be versioned together with the
# verifier contracts generated from them (audit H-03). Integrity: sdk/artifacts/MANIFEST.json
*.zkey
!sdk/artifacts/*.zkey

# frontend copy of the artifacts is synced from sdk/artifacts at dev/build time
frontend/public/zk/

# misc
.DS_Store
*.log

# local E2E deployment output
deployments/local.json
