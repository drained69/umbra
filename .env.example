# Target network: local | testnet | mainnet (mainnet has no EVM yet — see docs/MAINNET.md)
NETWORK=testnet

# Portaldot V3 testnet
PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777

# Deployer / relayer key (testnet only — never commit a real key)
PRIVATE_KEY=0xyourtestnetkey

# Units: native POT has 14 decimals, but the EVM layer (pallet-revive) scales values to
# 18 decimals (x10^4). ALL on-chain amounts are 18-dec: 1 tPOT = 10^18 EVM wei.
# Verified on testnet by `make preflight`. Only override if a network differs.
EVM_DECIMALS=18

# Denominations to create pools for, in whole tPOT (comma-separated)
DENOMINATIONS=1,10,100

# Merkle tree depth (must equal the circuit's: 20)
TREE_LEVELS=20

# Verifier mode: "onchain" (snarkjs Verifier.sol) or "coprocessor" (ink!/WASM bridge)
VERIFIER_MODE=onchain

# Coprocessor bridge wiring (only used when VERIFIER_MODE=coprocessor)
COPROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000
ATTESTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Relayer fee in basis points of the denomination (e.g. 50 = 0.5%)
RELAYER_FEE_BPS=50

# --- relayer hardening ---
RELAYER_PORT=8787
RELAYER_RATE_PER_MIN=10
RELAYER_CORS_ORIGIN=*                 # set to your frontend origin in production
RELAYER_ENFORCE_PROFIT=0              # 1 = refuse relays whose gas cost exceeds the fee

# --- cross-VM (only when VERIFIER_MODE=coprocessor) ---
CROSS_VM=0
PORTALDOT_WS=wss://test-node-v3.portaldot.dev
COPROCESSOR_CONTRACT=                 # SS58 address of the deployed ink! coprocessor
COPROCESSOR_METADATA=coprocessor/target/ink/umbra_coprocessor/umbra_coprocessor.json
SUBSTRATE_SEED=                       # attestor seed (testnet only)
